#!/bin/sh
# DnsJos node installer (SPEC §13), served by the panel at /install.sh.
#   curl -fsSL {{.PanelURL}}/install.sh | sudo sh -s -- --token TOKEN [--panel URL] [--adopt] [--no-start] [--with-unbound]
# Idempotent: safe to re-run. Supports Debian 12/13 and Ubuntu 22.04/24.04 on amd64/arm64.
set -eu

PANEL_URL='{{.PanelURL}}'
TOKEN=''
ADOPT=0
NO_START=0
WITH_UNBOUND=0
UNBOUND_ADDR='127.0.0.1@5335' # local recursive resolver, set as the profile upstream 127.0.0.1:5335
DNSDIST_SERIES='20' # dnsdist 2.0.x from repo.powerdns.com
AGENT_BIN=/usr/local/bin/dnsjos-agent
AGENT_CONF=/etc/dnsjos/agent.json
STATE_DIR=/var/lib/dnsjos
UNIT=/etc/systemd/system/dnsjos-agent.service

say() { printf '==> %s\n' "$*"; }
die() { printf 'dnsjos-install: error: %s\n' "$*" >&2; exit 1; }

usage() {
	cat <<EOF
usage: install.sh --token TOKEN [--panel URL] [--adopt] [--no-start] [--with-unbound]
  --token TOKEN  enrollment token from the panel (Nodes -> Add node)
  --panel URL    panel URL (default: $PANEL_URL)
  --adopt        take over a live dnsdist server: keep its dnsdist package, secrets,
                 listeners and port 53 setup (no repo, no install/upgrade, no resolved changes)
  --no-start     install the agent service but do not start it (review with 'dnsjos-agent plan')
  --with-unbound also install Unbound as a local recursive, DNSSEC-validating resolver on
                 127.0.0.1:5335; point the profile upstreams at it to stop forwarding to public DNS
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
		--token) [ $# -ge 2 ] || die "--token needs a value"; TOKEN=$2; shift 2 ;;
		--token=*) TOKEN=${1#--token=}; shift ;;
		--panel) [ $# -ge 2 ] || die "--panel needs a value"; PANEL_URL=$2; shift 2 ;;
		--panel=*) PANEL_URL=${1#--panel=}; shift ;;
		--adopt) ADOPT=1; shift ;;
		--no-start) NO_START=1; shift ;;
		--with-unbound) WITH_UNBOUND=1; shift ;;
		-h|--help) usage; exit 0 ;;
		*) usage >&2; die "unknown argument: $1" ;;
	esac
done
PANEL_URL=${PANEL_URL%/}

[ "$(id -u)" -eq 0 ] || die "must run as root (pipe into 'sudo sh')"
[ -n "$TOKEN" ] || [ -s "$AGENT_CONF" ] || { usage >&2; die "--token is required"; }
case "$PANEL_URL" in http://*|https://*) ;; *) die "--panel must be an http(s) URL" ;; esac

# ── 1. OS / architecture ────────────────────────────────────────────────────
[ -r /etc/os-release ] || die "cannot read /etc/os-release"
# shellcheck disable=SC1091
. /etc/os-release
OS_ID=${ID:-}
OS_VER=${VERSION_ID:-}
CODENAME=${VERSION_CODENAME:-}
case "$OS_ID:$OS_VER" in
	debian:12|debian:13|ubuntu:22.04|ubuntu:24.04) ;;
	*) die "unsupported OS ${PRETTY_NAME:-$OS_ID $OS_VER} (need Debian 12/13 or Ubuntu 22.04/24.04)" ;;
esac
[ -n "$CODENAME" ] || die "VERSION_CODENAME missing from /etc/os-release"

ARCH=$(dpkg --print-architecture 2>/dev/null || uname -m)
case "$ARCH" in
	amd64|x86_64) ARCH=amd64 ;;
	arm64|aarch64) ARCH=arm64 ;;
	*) die "unsupported architecture $ARCH (need amd64 or arm64)" ;;
esac
command -v systemctl >/dev/null 2>&1 || die "systemd is required"
say "installing DnsJos node on $OS_ID $OS_VER ($ARCH), panel $PANEL_URL"

export DEBIAN_FRONTEND=noninteractive
APT_OPTS='-y -q -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold'

need_pkgs=''
command -v curl >/dev/null 2>&1 || need_pkgs="$need_pkgs curl"
command -v sha256sum >/dev/null 2>&1 || need_pkgs="$need_pkgs coreutils"
[ -f /etc/ssl/certs/ca-certificates.crt ] || need_pkgs="$need_pkgs ca-certificates"
command -v gpg >/dev/null 2>&1 || need_pkgs="$need_pkgs gnupg"
if [ -n "$need_pkgs" ]; then
	say "installing prerequisites:$need_pkgs"
	apt-get update -q
	# shellcheck disable=SC2086
	apt-get install $APT_OPTS $need_pkgs
fi

mkdir -p "$STATE_DIR"
chmod 0711 "$STATE_DIR" # dnsdist reads the CDB below it; secrets stay 0600

# ── 2. back up an existing /etc/dnsdist before anything can touch it ────────
if [ -d /etc/dnsdist ] && [ -n "$(ls -A /etc/dnsdist 2>/dev/null)" ]; then
	BACKUP="$STATE_DIR/pre-install-$(date +%Y%m%d-%H%M%S)"
	mkdir -p "$BACKUP"
	cp -a /etc/dnsdist/. "$BACKUP/"
	say "backed up /etc/dnsdist to $BACKUP"
fi

# ── 3. dnsdist 2.0 from repo.powerdns.com, pinned ───────────────────────────
# An existing dnsdist is never upgraded implicitly: adopted servers keep their version.
if [ "$ADOPT" = 1 ]; then
	command -v dnsdist >/dev/null 2>&1 || die "--adopt: dnsdist is not installed"
	[ -s /etc/dnsdist/dnsdist.yml ] || die "--adopt: /etc/dnsdist/dnsdist.yml not found"
	say "adopting the running dnsdist: $(dnsdist --version 2>/dev/null | head -n 1)"
elif command -v dnsdist >/dev/null 2>&1; then
	say "dnsdist already installed, leaving it as is: $(dnsdist --version 2>/dev/null | head -n 1)"
else
KEYRING=/etc/apt/keyrings/dnsdist-$DNSDIST_SERIES-pub.asc
install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://repo.powerdns.com/FD380FBB-pub.asc -o "$KEYRING.tmp"
mv "$KEYRING.tmp" "$KEYRING"
chmod 0644 "$KEYRING"
echo "deb [signed-by=$KEYRING] https://repo.powerdns.com/$OS_ID $CODENAME-dnsdist-$DNSDIST_SERIES main" \
	>/etc/apt/sources.list.d/pdns-dnsdist.list
cat >/etc/apt/preferences.d/dnsdist-$DNSDIST_SERIES <<EOF
Package: dnsdist*
Pin: origin repo.powerdns.com
Pin-Priority: 600
EOF
say "installing dnsdist"
apt-get update -q
# shellcheck disable=SC2086
apt-get install $APT_OPTS dnsdist
command -v dnsdist >/dev/null 2>&1 || die "dnsdist was not installed"
say "$(dnsdist --version 2>/dev/null | head -n 1)"
fi

# Big UDP socket buffers (setUDPSocketBufferSizes 16 MB needs the kernel max raised).
cat >/etc/sysctl.d/90-dnsjos.conf <<EOF
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
EOF
sysctl -q -p /etc/sysctl.d/90-dnsjos.conf >/dev/null 2>&1 || true

# ── 4. free port 53 from the systemd-resolved stub listener ─────────────────
if [ "$ADOPT" = 0 ] && systemctl is-active --quiet systemd-resolved 2>/dev/null; then
	if ! grep -rqs '^DNSStubListener=no' /etc/systemd/resolved.conf /etc/systemd/resolved.conf.d; then
		say "disabling the systemd-resolved stub listener on :53"
		mkdir -p /etc/systemd/resolved.conf.d
		printf '[Resolve]\nDNSStubListener=no\n' >/etc/systemd/resolved.conf.d/dnsjos.conf
		systemctl restart systemd-resolved
	fi
	# The stub resolv.conf points at 127.0.0.53, which no longer answers.
	if [ "$(readlink /etc/resolv.conf 2>/dev/null || true)" != /run/systemd/resolve/resolv.conf ] &&
		grep -qs '^nameserver 127\.0\.0\.53' /etc/resolv.conf; then
		ln -sf /run/systemd/resolve/resolv.conf /etc/resolv.conf
	fi
fi

# ── 4b. optional Unbound recursive resolver on loopback ──────────────────────
# Config goes in before the package so Unbound never starts on its default :53 (dnsdist's).
if [ "$WITH_UNBOUND" = 1 ]; then
	say "installing unbound on ${UNBOUND_ADDR%@*}:${UNBOUND_ADDR#*@}"
	mkdir -p /etc/unbound/unbound.conf.d
	# Sized from the host: a thread per core (power-of-two slabs to cut lock contention) and
	# rrset cache = RAM/16 in 64m..1g, msg cache half that (Unbound uses ~2.5x the configured size).
	UB_THREADS=$(nproc 2>/dev/null || echo 1)
	[ "$UB_THREADS" -le 8 ] || UB_THREADS=8
	UB_SLABS=1
	while [ "$UB_SLABS" -lt "$UB_THREADS" ]; do UB_SLABS=$((UB_SLABS * 2)); done
	UB_RRSET=$(awk '/^MemTotal:/ {m = int($2 / 1024 / 16); if (m < 64) m = 64; if (m > 1024) m = 1024; print m; exit}' /proc/meminfo)
	UB_RRSET=${UB_RRSET:-128}
	# Only use IPv6 name servers when IPv6 actually reaches the internet: a default route
	# with a dead uplink makes every first lookup wait for IPv6 timeouts.
	UB_IP6=no
	if [ -n "$(ip -6 route show default 2>/dev/null)" ] &&
		{ ping -6 -c 1 -W 2 2001:4860:4860::8888 || ping -6 -c 1 -W 2 2606:4700:4700::1111; } >/dev/null 2>&1; then
		UB_IP6=yes
	fi
	cat >/etc/unbound/unbound.conf.d/dnsjos.conf <<EOF
# Managed by the DnsJos installer: recursive resolver behind dnsdist, loopback only.
# Re-run the installer with --with-unbound to resize after a CPU/RAM change.
server:
    interface: ${UNBOUND_ADDR}
    access-control: 127.0.0.0/8 allow
    do-ip6: ${UB_IP6}
    hide-identity: yes
    hide-version: yes

    # threads and sockets
    num-threads: ${UB_THREADS}
    so-reuseport: yes
    so-rcvbuf: 4m
    so-sndbuf: 4m
    outgoing-range: 8192
    num-queries-per-thread: 4096
    incoming-num-tcp: 256
    outgoing-num-tcp: 64

    # caches
    msg-cache-slabs: ${UB_SLABS}
    rrset-cache-slabs: ${UB_SLABS}
    infra-cache-slabs: ${UB_SLABS}
    key-cache-slabs: ${UB_SLABS}
    rrset-cache-size: ${UB_RRSET}m
    msg-cache-size: $((UB_RRSET / 2))m
    key-cache-size: $((UB_RRSET / 8))m
    neg-cache-size: $((UB_RRSET / 16))m
    cache-max-negative-ttl: 300

    # latency: refresh popular names before they expire, answer stale while refreshing
    # (RFC 8767), and synthesize NXDOMAIN from cached NSEC (RFC 8198)
    prefetch: yes
    prefetch-key: yes
    serve-expired: yes
    serve-expired-ttl: 86400
    serve-expired-client-timeout: 0
    aggressive-nsec: yes
    qname-minimisation: yes
    rrset-roundrobin: yes
    harden-below-nxdomain: yes
EOF
	# The package would point the host's resolv.conf at 127.0.0.1:53, where dnsdist (not Unbound) answers.
	systemctl mask unbound-resolvconf.service >/dev/null 2>&1 || true
	command -v unbound >/dev/null 2>&1 || {
		apt-get update -q
		# shellcheck disable=SC2086
		apt-get install $APT_OPTS unbound
	}
	unbound-checkconf >/dev/null || die "unbound config check failed (unbound-checkconf)"
	systemctl enable unbound >/dev/null 2>&1
	systemctl restart unbound
	say "unbound ready: set the profile upstream to ${UNBOUND_ADDR%@*}:${UNBOUND_ADDR#*@}"
fi

# ── 5. agent binary (sha256-verified) ───────────────────────────────────────
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT INT TERM
say "downloading dnsjos-agent (linux/$ARCH)"
curl -fsSL "$PANEL_URL/dl/agent/linux/$ARCH" -o "$TMP/dnsjos-agent" ||
	die "agent download failed: $PANEL_URL/dl/agent/linux/$ARCH"
WANT=$(curl -fsSL "$PANEL_URL/dl/agent/linux/$ARCH.sha256" | awk '{print $1; exit}')
GOT=$(sha256sum "$TMP/dnsjos-agent" | awk '{print $1}')
if [ -z "$WANT" ] || [ "$WANT" != "$GOT" ]; then
	die "agent checksum mismatch (want '$WANT', got '$GOT')"
fi
install -m 0755 "$TMP/dnsjos-agent" "$AGENT_BIN.new"
mv -f "$AGENT_BIN.new" "$AGENT_BIN"

# ── 6. enroll (skipped when already enrolled; tokens are single-use) ────────
if [ -s "$AGENT_CONF" ]; then
	say "already enrolled ($AGENT_CONF exists); delete it and re-run with a new token to re-enroll"
else
	say "enrolling with the panel"
	if [ "$ADOPT" = 1 ]; then
		"$AGENT_BIN" enroll --panel "$PANEL_URL" --token "$TOKEN" --adopt || die "enrollment failed"
	else
		"$AGENT_BIN" enroll --panel "$PANEL_URL" --token "$TOKEN" || die "enrollment failed"
	fi
	[ -s "$AGENT_CONF" ] || die "enrollment did not write $AGENT_CONF"
fi

# ── 7. systemd service ──────────────────────────────────────────────────────
cat >"$UNIT" <<'EOF'
[Unit]
Description=DnsJos node agent (manages dnsdist)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dnsjos-agent run
Restart=always
RestartSec=5
# SIGTERM the agent only: it waits for a running apt/dpkg upgrade or dnsdist restart
# before exiting, so give it time instead of killing dpkg mid-way.
KillMode=mixed
TimeoutStopSec=15min
StateDirectory=dnsjos
StateDirectoryMode=0711

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
if [ "$NO_START" = 1 ]; then
	say "agent installed but NOT started. Review what it would change, then start it:"
	say "  $AGENT_BIN plan"
	say "  systemctl enable --now dnsjos-agent"
	exit 0
fi
systemctl enable dnsjos-agent >/dev/null 2>&1
systemctl restart dnsjos-agent

NODE_ID=$(sed -n 's/.*"node_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$AGENT_CONF" | head -n 1)
say "done: node $(hostname) (id ${NODE_ID:-unknown}) is managed by $PANEL_URL"
say "it appears as online in the panel within a few seconds; logs: journalctl -u dnsjos-agent -f"
