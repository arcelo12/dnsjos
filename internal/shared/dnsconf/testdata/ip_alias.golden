newServer({address = "8.8.4.4:53", name = "google2", weight = 20, order = 1, sockets = 4, checkInterval = 1, pool = ""})
setServerPolicyLuaFFIPerThread("whashedLatency", [[
  local ffi = require("ffi")
  local C = ffi.C
  local floor = 20000
  local srv = ffi.new("const dnsdist_ffi_server_t*[1]")
  local cum, total, stamp, count = {}, 0, -1, -1
  local function recompute(list, n)
    local best, lat, w = math.huge, {}, {}
    for i = 0, n - 1 do
      C.dnsdist_ffi_servers_list_get_server(list, i, srv)
      if C.dnsdist_ffi_server_is_up(srv[0]) then
        lat[i] = math.max(C.dnsdist_ffi_server_get_latency(srv[0]), floor)
        w[i] = C.dnsdist_ffi_server_get_weight(srv[0])
        best = math.min(best, lat[i])
      end
    end
    total = 0
    for i = 0, n - 1 do
      if lat[i] then total = total + math.max(1, math.floor(w[i] * best / lat[i] + 0.5)) end
      cum[i] = total
    end
  end
  return function(list, dq)
    local n = tonumber(C.dnsdist_ffi_servers_list_get_count(list))
    local now = os.time()
    if now ~= stamp or n ~= count then
      stamp, count = now, n
      recompute(list, n)
    end
    if total == 0 then return n end
    for _ = 1, 2 do
      local h = tonumber(C.dnsdist_ffi_dnsquestion_get_qname_hash(dq, 0) % total)
      for i = 0, n - 1 do
        if h < cum[i] then
          C.dnsdist_ffi_servers_list_get_server(list, i, srv)
          if C.dnsdist_ffi_server_is_up(srv[0]) then return i end
          break
        end
      end
      recompute(list, n) -- a server went down since the last recompute
      if total == 0 then return n end
    end
    return n
  end
]])

dofile("/etc/dnsdist/dnsjos/ip-alias.lua")
==> dnsjos/ip-alias.lua <==
-- generated by dnsjos, do not edit
-- IP-alias, smartdist's ip-rules ip-set aliasing. An answer of a name whose A/AAAA
-- address falls inside a rule's match_pools has every such address rewritten to the rule's
-- targets, cycling through them. Names in a rule's exclude list (and their subdomains) keep
-- their real addresses.
declareMetric("ip-alias-rewrites", "counter", "A/AAAA answers pinned to a configured edge IP")
local function skipName(p, pos)
  while true do
    local len = p:byte(pos)
    if not len then return nil end
    if len == 0 then return pos + 1 end
    if len >= 192 then return pos + 2 end
    pos = pos + len + 1
  end
end

local function at16(p, i) return p:byte(i) * 256 + p:byte(i + 1) end

-- fmtAddr renders the rdlen-byte address at 1-based offset rd as a string for newCA.
local function fmtAddr(p, rd, rdlen)
  if rdlen == 4 then return string.format("%d.%d.%d.%d", p:byte(rd), p:byte(rd + 1), p:byte(rd + 2), p:byte(rd + 3)) end
  local g = {}
  for i = 0, 7 do g[#g + 1] = string.format("%x", at16(p, rd + i * 2)) end
  return table.concat(g, ":")
end

-- ipToBytes turns an address string into its 4 (IPv4) or 16 (IPv6) wire bytes.
local function ip4ToBytes(s)
  local a, b, c, d = s:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
  if not a then return nil end
  return string.char(tonumber(a), tonumber(b), tonumber(c), tonumber(d))
end

-- parse6 turns an IPv6 address into its 16 bytes (nil when malformed).
local function parse6(s)
  local function split(x)
    local t = {}
    for g in x:gmatch("[^:]+") do t[#t + 1] = g end
    return t
  end
  local groups
  local head, tail = s:match("^([%x:]-)::([%x:]*)$")
  if head then
    local h, t = split(head), split(tail)
    if #h + #t > 7 then return nil end
    groups = h
    for _ = 1, 8 - #h - #t do groups[#groups + 1] = "0" end
    for _, g in ipairs(t) do groups[#groups + 1] = g end
  else
    groups = split(s)
  end
  if #groups ~= 8 then return nil end
  local b = {}
  for _, g in ipairs(groups) do
    if #g > 4 or not g:match("^%x+$") then return nil end
    local v = tonumber(g, 16)
    b[#b + 1] = string.char(math.floor(v / 256), v % 256)
  end
  return table.concat(b)
end

local function ipToBytes(s)
  if s:find(":", 1, true) then return parse6(s) end
  return ip4ToBytes(s)
end

local ipa0 = { name = "cf", qtype = DNSQType.A, rdlen = 4, rr = 0, excluded = false,
  pools = newNMG(), targets = {}, exclude = newSuffixMatchNode() }
for _, m in ipairs({"104.16.0.0/13", "172.64.0.0/13"}) do ipa0.pools:addMask(m) end
for _, t in ipairs({"172.64.52.159", "172.64.87.224"}) do local b = ipToBytes(t) if b and #b == 4 then ipa0.targets[#ipa0.targets + 1] = b end end
for _, e in ipairs({"cftunnel.com"}) do ipa0.exclude:add(newDNSName(e)) ipa0.excluded = true end
if #ipa0.targets > 0 and ipa0.pools:size() > 0 then
  addResponseAction(AndRule({RCodeRule(DNSRCode.NOERROR), QTypeRule(ipa0.qtype)}),
                    LuaResponseAction(function(dr)
    if ipa0.excluded and ipa0.exclude:check(dr.qname) then return DNSResponseAction.None, "" end
    local p = dr:getContent()
    if #p < 12 or at16(p, 5) ~= 1 or p:byte(3) % 4 >= 2 then return DNSResponseAction.None, "" end -- 1 question, not TC
    local pos = skipName(p, 13)
    if not pos or pos + 3 > #p then return DNSResponseAction.None, "" end
    pos = pos + 4 -- first byte after the question
    -- Pass 1: is any answer address inside one of the rule's pools?
    local hits, scan = {}, pos
    for _ = 1, at16(p, 7) do
      scan = skipName(p, scan)
      if not scan or scan + 9 > #p then return DNSResponseAction.None, "" end
      local t, rl = at16(p, scan), at16(p, scan + 8)
      local rd = scan + 10
      if rd + rl - 1 > #p then return DNSResponseAction.None, "" end
      if t == ipa0.qtype and rl == ipa0.rdlen then
        if ipa0.pools:match(newCA(fmtAddr(p, rd, ipa0.rdlen))) then hits[#hits + 1] = rd end
      end
      scan = rd + rl
    end
    if #hits == 0 then return DNSResponseAction.None, "" end
    -- Pass 2: overwrite each matching address in place, cycling through the targets.
    local bytes = { p:byte(1, #p) }
    local nt = #ipa0.targets
    for _, rd in ipairs(hits) do
      local tb = ipa0.targets[(ipa0.rr % nt) + 1]
      ipa0.rr = ipa0.rr + 1
      for i = 0, ipa0.rdlen - 1 do bytes[rd + i] = tb:byte(i + 1) end
    end
    local out = {}
    for i = 1, #bytes do out[i] = string.char(bytes[i]) end
    dr:setContent(table.concat(out))
    incMetric("ip-alias-rewrites")
    return DNSResponseAction.None, ""
  end), {name = "dnsjos-ip-alias: " .. ipa0.name})
end

local ipa1 = { name = "cf6", qtype = DNSQType.AAAA, rdlen = 16, rr = 0, excluded = false,
  pools = newNMG(), targets = {}, exclude = newSuffixMatchNode() }
for _, m in ipairs({"2606:4700::/32"}) do ipa1.pools:addMask(m) end
for _, t in ipairs({"2606:4700:3030::6810:3459"}) do local b = ipToBytes(t) if b and #b == 16 then ipa1.targets[#ipa1.targets + 1] = b end end
for _, e in ipairs({}) do ipa1.exclude:add(newDNSName(e)) ipa1.excluded = true end
if #ipa1.targets > 0 and ipa1.pools:size() > 0 then
  addResponseAction(AndRule({RCodeRule(DNSRCode.NOERROR), QTypeRule(ipa1.qtype)}),
                    LuaResponseAction(function(dr)
    if ipa1.excluded and ipa1.exclude:check(dr.qname) then return DNSResponseAction.None, "" end
    local p = dr:getContent()
    if #p < 12 or at16(p, 5) ~= 1 or p:byte(3) % 4 >= 2 then return DNSResponseAction.None, "" end -- 1 question, not TC
    local pos = skipName(p, 13)
    if not pos or pos + 3 > #p then return DNSResponseAction.None, "" end
    pos = pos + 4 -- first byte after the question
    -- Pass 1: is any answer address inside one of the rule's pools?
    local hits, scan = {}, pos
    for _ = 1, at16(p, 7) do
      scan = skipName(p, scan)
      if not scan or scan + 9 > #p then return DNSResponseAction.None, "" end
      local t, rl = at16(p, scan), at16(p, scan + 8)
      local rd = scan + 10
      if rd + rl - 1 > #p then return DNSResponseAction.None, "" end
      if t == ipa1.qtype and rl == ipa1.rdlen then
        if ipa1.pools:match(newCA(fmtAddr(p, rd, ipa1.rdlen))) then hits[#hits + 1] = rd end
      end
      scan = rd + rl
    end
    if #hits == 0 then return DNSResponseAction.None, "" end
    -- Pass 2: overwrite each matching address in place, cycling through the targets.
    local bytes = { p:byte(1, #p) }
    local nt = #ipa1.targets
    for _, rd in ipairs(hits) do
      local tb = ipa1.targets[(ipa1.rr % nt) + 1]
      ipa1.rr = ipa1.rr + 1
      for i = 0, ipa1.rdlen - 1 do bytes[rd + i] = tb:byte(i + 1) end
    end
    local out = {}
    for i = 1, #bytes do out[i] = string.char(bytes[i]) end
    dr:setContent(table.concat(out))
    incMetric("ip-alias-rewrites")
    return DNSResponseAction.None, ""
  end), {name = "dnsjos-ip-alias: " .. ipa1.name})
end
